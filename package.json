{
  "name": "scotaccount-totp-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Local TOTP server so Maestro E2E flows can fetch a fresh ScotAccount code",
  "type": "module",
  "scripts": {
    "otp:server": "node otp-server.js",
    "otp:print": "node otp-print.js",
    "e2e:scotaccount": "bash scripts/run-maestro-with-otp.sh maestro/scotaccount-login.yaml"
  },
  "dependencies": {
    "otplib": "^12.0.1"
  }
}
